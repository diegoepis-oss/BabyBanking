# Copia questo file in .env.local e riempi i valori per lo sviluppo in locale.
# Gli stessi nomi di variabile vanno configurati anche su Vercel
# (Settings -> Environment Variables) per l'app online.

# Da Supabase: Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Da Supabase: Project Settings -> API Keys -> service_role (segreta, non condividerla)
SUPABASE_SERVICE_ROLE_KEY=

# Una stringa lunga e casuale, usata per firmare il cookie di accesso.
# Puoi generarne una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Un'altra stringa lunga e casuale (diversa da SESSION_SECRET), usata per
# proteggere gli indirizzi dei Cron Job (/api/cron/...) da chiamate esterne.
# Stessa modalità di generazione di SESSION_SECRET.
CRON_SECRET=

# Il tuo indirizzo Gmail, usato per inviare l'email di backup settimanale.
GMAIL_USER=

# Password per le app di Google (16 caratteri, NON la password normale del
# tuo account): myaccount.google.com -> Sicurezza -> Verifica in due passaggi
# (va attivata se non lo è già) -> Password per le app.
GMAIL_APP_PASSWORD=

# L'indirizzo a cui inviare il backup settimanale (può essere lo stesso di
# GMAIL_USER, o un altro indirizzo).
BACKUP_EMAIL_TO=
