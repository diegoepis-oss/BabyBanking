# Copia questo file in .env.local e riempi i valori per lo sviluppo in locale.
# Gli stessi nomi di variabile vanno configurati anche su Vercel
# (Settings -> Environment Variables) per l'app online.

# Da Supabase: Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Da Supabase: Project Settings -> API Keys -> service_role (segreta, non condividerla)
SUPABASE_SERVICE_ROLE_KEY=

# Una stringa lunga e casuale, usata per firmare il cookie di accesso.
# Puoi generarne una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
